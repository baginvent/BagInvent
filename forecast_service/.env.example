# Example Environment Configuration for Forecast Service

# Frontend Environment (.env or .env.local)
# This tells the frontend where to reach the forecast service

# Development (local machine)
VITE_FORECAST_API_URL=http://localhost:5000

# Production (deployed service)
# VITE_FORECAST_API_URL=https://forecast-api.yourdomain.com:5000
# VITE_FORECAST_API_URL=https://api.yourdomain.com/forecast

# Docker deployment
# VITE_FORECAST_API_URL=http://forecast-service:5000

# Service Configuration (Python)
# These can be set in app.py or as environment variables

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=False

# Service Port
FORECAST_SERVICE_PORT=5000

# Service Host (use 0.0.0.0 for Docker/production, 127.0.0.1 for local dev)
FORECAST_SERVICE_HOST=127.0.0.1

# Logging Level
LOG_LEVEL=INFO

# Max workers (for production with Gunicorn)
# GUNICORN_WORKERS=4
